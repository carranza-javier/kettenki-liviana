# Liviana environment variables.
#
# In production these are set by CloudFormation on the Lambda function (see
# infra/template.yaml); this file documents every knob and is what you copy
# when you run the aws backend from your own machine.
#
# Nothing here is baked into the code. A different client means a different
# bucket, a different content document and a different set of these values.

# --- Backend selection -------------------------------------------------------
# mock = local files, no AWS account needed. aws = S3 + DynamoDB + Bedrock.
LIVIANA_BACKEND=mock

# --- AWS ---------------------------------------------------------------------
# Injected automatically inside Lambda. Set it locally to point at your region.
LIVIANA_REGION=eu-central-1

# --- Content document --------------------------------------------------------
# aws backend: bucket + key. Required when LIVIANA_BACKEND=aws.
LIVIANA_CONTENT_BUCKET=
LIVIANA_CONTENT_KEY=content.json
# mock backend: path on disk. Defaults to <repo>/content/content.json.
LIVIANA_CONTENT_PATH=
# How long a loaded document is reused before S3 is read again.
LIVIANA_CONTENT_CACHE_TTL_S=300

# --- Conversation state ------------------------------------------------------
# aws backend: the two DynamoDB tables. Required when LIVIANA_BACKEND=aws.
# Conversations: one item per session, partition key sessionId, TTL expires_at.
LIVIANA_CONVERSATIONS_TABLE=
# Limits: one item per counter window, partition key id, TTL expires_at.
LIVIANA_LIMITS_TABLE=
# mock backend: the local state file. Defaults to <repo>/.liviana-state.json.
LIVIANA_STATE_PATH=

# --- Model -------------------------------------------------------------------
# Required when LIVIANA_BACKEND=aws. Verify the id exists in your region with
#   aws bedrock list-inference-profiles --region eu-central-1
LIVIANA_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Low temperature: this is a factual assistant, not a creative one.
LIVIANA_TEMPERATURE=0.2
# Short answers are the product decision and the cost decision at once.
LIVIANA_MAX_TOKENS=400

# --- Conversation memory -----------------------------------------------------
# Message pairs replayed to the model. Every pair is re-sent as input on every
# turn, so this number multiplies the input cost of a long conversation.
LIVIANA_HISTORY_PAIRS=4
# How long a conversation survives in DynamoDB before TTL removes it.
LIVIANA_CONVERSATION_TTL_HOURS=24

# --- Cost and abuse protection ----------------------------------------------
LIVIANA_RATE_LIMIT_PER_MINUTE=20
LIVIANA_DAILY_INVOCATION_LIMIT=500
LIVIANA_MAX_MESSAGE_CHARS=1000

# --- HTTP --------------------------------------------------------------------
# Set this to the real site before going live.
LIVIANA_ALLOWED_ORIGIN=*

# --- Logging -----------------------------------------------------------------
LIVIANA_LOG_LEVEL=INFO
# Off by default: turning it on writes visitor questions and answers to
# CloudWatch, which is a privacy decision, not a debugging convenience.
LIVIANA_LOG_MESSAGES=false
